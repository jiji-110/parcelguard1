# Copie ce fichier en .env.local et remplis les valeurs.

# Base PostgreSQL (Neon, Supabase, Railway...). Laisse vide en local :
# l'app utilise alors une base intégrée stockée dans .data/
DATABASE_URL=

# Chaîne aléatoire d'au moins 32 caractères pour signer les sessions.
# Génère-la avec : openssl rand -base64 32
AUTH_SECRET=remplace-moi-par-une-longue-chaine-aleatoire

# Clé que Make (ou tout autre automate) envoie dans l'en-tête X-Internal-Key.
INTERNAL_API_KEY=remplace-moi-par-une-autre-chaine

# Secret de la tâche planifiée. Vercel l'envoie automatiquement en Bearer.
CRON_SECRET=remplace-moi-aussi

# Délai avant l'envoi automatique d'une réclamation détectée (heures).
AUTO_SEND_DELAY_HOURS=6
